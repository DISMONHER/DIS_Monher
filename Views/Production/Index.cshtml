@model IEnumerable<DIS_Monher.Models.OrdenProduccion>

@{
    ViewData["Title"] = "Production Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark m-0">Production Orders</h2>
        <p class="text-muted small m-0">
            Programación, consumo de materiales e inspecciones de calidad.
        </p>
    </div>

    <button class="btn btn-monher-primary shadow-sm"
            data-bs-toggle="modal"
            data-bs-target="#newOrderModal">
        <i class="fa-solid fa-plus me-2"></i>
        Crear Orden de Producción
    </button>
</div>


<div class="card-monher p-4 bg-white mb-4">

    <div class="table-responsive">

        <table class="table table-monher align-middle">

            <thead>
                <tr>
                    <th>N° Orden</th>
                    <th>Cliente</th>
                    <th>Caja / Producto</th>
                    <th>Progreso</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    var porcentaje = item.Cantidad > 0
                        ? (item.CantidadProducida * 100 / item.Cantidad)
                        : 0;

                    <!-- FILA PRINCIPAL DE LA ORDEN -->
                    <tr>

                        <td class="fw-bold text-primary">
                            @item.NumeroOrden
                        </td>

                        <td>
                            @item.Cliente
                        </td>

                        <td>
                            @item.TipoCaja
                        </td>

                        <td style="min-width:180px;">

                            <div class="fw-bold">
                                @item.CantidadProducida / @item.Cantidad
                            </div>

                            <div class="progress mt-1"
                                 style="height:6px;">

                                <div class="progress-bar bg-primary"
                                     role="progressbar"
                                     style="width:@porcentaje%">
                                </div>

                            </div>

                        </td>


                        <td>

                            @if (item.Estado == "Terminado")
                            {
                                <span class="badge bg-success rounded-pill">
                                    Terminado
                                </span>
                            }
                            else if (item.Estado == "En Proceso")
                            {
                                <span class="badge bg-warning text-dark rounded-pill">
                                    En Proceso
                                </span>
                            }
                            else if (item.Estado == "Cancelado")
                            {
                                <span class="badge bg-danger rounded-pill">
                                    Cancelado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark rounded-pill">
                                    Pendiente
                                </span>
                            }

                        </td>


                        <td>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#detalle-@item.Id"
                                    aria-expanded="false">

                                <i class="fa-solid fa-eye me-1"></i>
                                Ver detalle

                            </button>

                        </td>

                    </tr>


                    <!-- DETALLE DE LA ORDEN -->
                    <tr>

                        <td colspan="6"
                            class="p-0 border-0">

                            <div class="collapse"
                                 id="detalle-@item.Id">

                                <div class="p-4 bg-light">


                                    <!-- ============================================= -->
                                    <!-- HU008: AVANCE DE PRODUCCIÓN                  -->
                                    <!-- ============================================= -->

                                    <div class="row g-4">


                                        <!-- ACTUALIZAR AVANCE -->
                                        <div class="col-lg-5">

                                            <div class="card border-0 shadow-sm h-100">

                                                <div class="card-body p-4">

                                                    <h6 class="fw-bold mb-1">
                                                        Actualizar avance
                                                    </h6>

                                                    <p class="text-muted small mb-4">
                                                        Registra el progreso actual de la orden.
                                                    </p>


                                                    @if (item.Estado is "Terminado" or "Cancelado")
                                                    {
                                                        <div class="alert alert-secondary mb-0">

                                                            <i class="fa-solid fa-lock me-2"></i>

                                                            Esta orden se encuentra cerrada.

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="ActualizarAvance"
                                                              method="post">

                                                            <input type="hidden"
                                                                   name="ordenId"
                                                                   value="@item.Id" />


                                                            <div class="mb-3">

                                                                <label class="form-label fw-semibold">
                                                                    Estado
                                                                </label>

                                                                <select name="estado"
                                                                        class="form-select rounded-3">

                                                                    <option value="En Proceso">
                                                                        En proceso
                                                                    </option>

                                                                    <option value="Cancelado">
                                                                        Cancelar
                                                                    </option>

                                                                </select>

                                                            </div>


                                                            <div class="mb-3">

                                                                <label class="form-label fw-semibold">
                                                                    Cantidad producida
                                                                </label>

                                                                <input type="number"
                                                                       min="@item.CantidadProducida"
                                                                       max="@item.Cantidad"
                                                                       name="cantidadProducida"
                                                                       value="@item.CantidadProducida"
                                                                       class="form-control rounded-3" />

                                                                <small class="text-muted">
                                                                    Máximo: @item.Cantidad unidades
                                                                </small>

                                                            </div>


                                                            <div class="mb-3">

                                                                <label class="form-label fw-semibold">
                                                                    Observaciones
                                                                </label>

                                                                <textarea name="observaciones"
                                                                          class="form-control rounded-3"
                                                                          rows="3"
                                                                          placeholder="Ej. Se completó el primer lote de producción"></textarea>

                                                            </div>


                                                            <button type="submit"
                                                                    class="btn btn-monher-primary w-100">

                                                                <i class="fa-solid fa-rotate me-2"></i>
                                                                Actualizar avance

                                                            </button>

                                                        </form>
                                                    }

                                                </div>

                                            </div>

                                        </div>


                                        <!-- HISTORIAL DE AVANCES -->
                                        <div class="col-lg-7">

                                            <div class="card border-0 shadow-sm h-100">

                                                <div class="card-body p-4">

                                                    <h6 class="fw-bold mb-1">
                                                        Historial de avances
                                                    </h6>

                                                    <p class="text-muted small mb-4">
                                                        Registro del progreso de esta orden.
                                                    </p>


                                                    @if (item.Avances != null &&
                                                         item.Avances.Any())
                                                    {
                                                        <div class="table-responsive">

                                                            <table class="table table-sm align-middle mb-0">

                                                                <thead class="table-light">

                                                                    <tr>
                                                                        <th>Fecha</th>
                                                                        <th>Estado</th>
                                                                        <th>Cantidad</th>
                                                                        <th>Observaciones</th>
                                                                    </tr>

                                                                </thead>

                                                                <tbody>

                                                                    @foreach (var avance in
                                                                        item.Avances
                                                                            .OrderByDescending(a => a.Fecha))
                                                                    {
                                                                        <tr>

                                                                            <td class="text-nowrap">
                                                                                @avance.Fecha.ToString("dd/MM/yyyy HH:mm")
                                                                            </td>

                                                                            <td>
                                                                                @avance.Estado
                                                                            </td>

                                                                            <td class="text-nowrap">
                                                                                @avance.CantidadProducida / @item.Cantidad
                                                                            </td>

                                                                            <td>
                                                                                @(string.IsNullOrWhiteSpace(avance.Observaciones)
                                                                                    ? "-"
                                                                                    : avance.Observaciones)
                                                                            </td>

                                                                        </tr>
                                                                    }

                                                                </tbody>

                                                            </table>

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center py-4 text-muted">

                                                            <i class="fa-regular fa-clock fs-4 mb-2"></i>

                                                            <p class="mb-0">
                                                                No hay avances registrados.
                                                            </p>

                                                        </div>
                                                    }

                                                </div>

                                            </div>

                                        </div>

                                    </div>



                                    <!-- ============================================= -->
                                    <!-- HU007: MATERIALES ASIGNADOS                  -->
                                    <!-- ============================================= -->

                                    <div class="row mt-4">

                                        <div class="col-12">

                                            <div class="card border-0 shadow-sm">

                                                <div class="card-body p-4">


                                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                                        <div>

                                                            <h6 class="fw-bold mb-1">
                                                                Materiales asignados
                                                            </h6>

                                                            <p class="text-muted small mb-0">
                                                                Materiales utilizados en esta orden de producción.
                                                            </p>

                                                        </div>

                                                    </div>


                                                    @if (item.MaterialesAsignados != null &&
                                                         item.MaterialesAsignados.Any())
                                                    {
                                                        <div class="table-responsive mb-4">

                                                            <table class="table table-sm align-middle">

                                                                <thead class="table-light">

                                                                    <tr>
                                                                        <th>Material</th>
                                                                        <th>Cantidad asignada</th>
                                                                        <th>Responsable</th>
                                                                        <th>Fecha</th>
                                                                        <th>Último ajuste</th>
                                                                    </tr>

                                                                </thead>

                                                                <tbody>

                                                                    @foreach (var detalle in item.MaterialesAsignados)
                                                                    {
                                                                        <tr>

                                                                            <td>
                                                                                @(detalle.Material?.Nombre ?? "Material")
                                                                            </td>

                                                                            <td>
                                                                                @detalle.Cantidad
                                                                            </td>

                                                                            <td>
                                                                                @(string.IsNullOrWhiteSpace(detalle.ResponsableAsignacion)
                                                                                    ? "-"
                                                                                    : detalle.ResponsableAsignacion)
                                                                            </td>

                                                                            <td>
                                                                                @detalle.FechaAsignacion.ToString("dd/MM/yyyy HH:mm")
                                                                            </td>

                                                                            <td>

                                                                                @if (detalle.FechaUltimoAjuste.HasValue)
                                                                                {
                                                                                    <div>
                                                                                        @detalle.FechaUltimoAjuste.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                    </div>

                                                                                    @if (!string.IsNullOrWhiteSpace(detalle.JustificacionAjuste))
                                                                                    {
                                                                                        <small class="text-muted">
                                                                                            @detalle.JustificacionAjuste
                                                                                        </small>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">
                                                                                        Sin ajustes
                                                                                    </span>
                                                                                }

                                                                            </td>

                                                                        </tr>
                                                                    }

                                                                </tbody>

                                                            </table>

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-light border">
                                                            No hay materiales asignados a esta orden.
                                                        </div>
                                                    }



                                                    <!-- ASIGNAR MATERIAL ADICIONAL -->
                                                    @if (item.Estado is not "Terminado" and not "Cancelado")
                                                    {
                                                        <hr class="my-4" />

                                                        <h6 class="fw-bold mb-3">
                                                            Asignar material adicional
                                                        </h6>


                                                        <form asp-action="AsignarMateriales"
                                                              method="post">

                                                            <input type="hidden"
                                                                   name="ordenId"
                                                                   value="@item.Id" />


                                                            <div class="row g-3">


                                                                <!-- MATERIAL -->
                                                                <div class="col-md-4">

                                                                    <label class="form-label fw-semibold">
                                                                        Material
                                                                    </label>

                                                                    <select name="materialIds"
                                                                            class="form-select"
                                                                            required>

                                                                        <option value="">
                                                                            Seleccione un material
                                                                        </option>

                                                                        @foreach (var material in
                                                                            (List<DIS_Monher.Models.Material>)ViewBag.Materiales)
                                                                        {
                                                                            <option value="@material.Id">
                                                                                @material.Nombre - Stock: @material.StockActual
                                                                            </option>
                                                                        }

                                                                    </select>

                                                                </div>


                                                                <!-- CANTIDAD -->
                                                                <div class="col-md-2">

                                                                    <label class="form-label fw-semibold">
                                                                        Cantidad
                                                                    </label>

                                                                    <input type="number"
                                                                           name="cantidades"
                                                                           min="0.01"
                                                                           step="0.01"
                                                                           class="form-control"
                                                                           required />

                                                                </div>


                                                                <!-- RESPONSABLE -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Responsable
                                                                    </label>

                                                                    <input type="text"
                                                                           name="responsable"
                                                                           value="@item.Responsable"
                                                                           class="form-control"
                                                                           required />

                                                                </div>


                                                                <!-- JUSTIFICACIÓN -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Justificación
                                                                    </label>

                                                                    <input type="text"
                                                                           name="justificacion"
                                                                           class="form-control"
                                                                           placeholder="Solo si es un ajuste" />

                                                                </div>

                                                            </div>


                                                            <div class="mt-3 text-end">

                                                                <button type="submit"
                                                                        class="btn btn-monher-primary">

                                                                    <i class="fa-solid fa-boxes-stacked me-2"></i>
                                                                    Asignar material

                                                                </button>

                                                            </div>

                                                        </form>
                                                    }

                                                </div>

                                            </div>

                                        </div>

                                    </div>



                                    <!-- ============================================= -->
                                    <!-- HU009: CONTROL DE CALIDAD                    -->
                                    <!-- ============================================= -->

                                    @if (item.Estado == "Terminado")
                                    {
                                        <div class="row mt-4">

                                            <div class="col-12">

                                                <div class="card border-0 shadow-sm">

                                                    <div class="card-body p-4">


                                                        <div class="mb-4">

                                                            <h6 class="fw-bold mb-1">
                                                                Control de Calidad
                                                            </h6>

                                                            <p class="text-muted small mb-0">
                                                                Registra la inspección del lote producido antes de enviarlo a distribución.
                                                            </p>

                                                        </div>


                                                        <form asp-action="RegistrarCalidad"
                                                              method="post"
                                                              enctype="multipart/form-data">


                                                            <input type="hidden"
                                                                   name="OrdenProduccionId"
                                                                   value="@item.Id" />


                                                            <div class="row g-3">


                                                                <!-- LOTE -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Lote
                                                                    </label>

                                                                    <input type="text"
                                                                           name="Lote"
                                                                           class="form-control rounded-3"
                                                                           placeholder="Ej. LOTE-001"
                                                                           required />

                                                                </div>


                                                                <!-- INSPECTOR -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Inspector
                                                                    </label>

                                                                    <input type="text"
                                                                           name="Inspector"
                                                                           class="form-control rounded-3"
                                                                           placeholder="Nombre del inspector"
                                                                           required />

                                                                </div>


                                                                <!-- RESULTADO -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Resultado
                                                                    </label>

                                                                    <select name="Aprobado"
                                                                            class="form-select rounded-3"
                                                                            required>

                                                                        <option value="">
                                                                            Seleccione
                                                                        </option>

                                                                        <option value="true">
                                                                            Aprobado
                                                                        </option>

                                                                        <option value="false">
                                                                            Rechazado
                                                                        </option>

                                                                    </select>

                                                                </div>


                                                                <!-- EVIDENCIAS -->
                                                                <div class="col-md-3">

                                                                    <label class="form-label fw-semibold">
                                                                        Evidencias fotográficas
                                                                    </label>

                                                                    <input type="file"
                                                                           name="evidencias"
                                                                           class="form-control rounded-3"
                                                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                                                           multiple />

                                                                    <small class="text-muted">
                                                                        JPG, PNG o WEBP. Máx. 5 MB por imagen.
                                                                    </small>

                                                                </div>

                                                            </div>


                                                            <!-- OBSERVACIONES -->
                                                            <div class="mt-3">

                                                                <label class="form-label fw-semibold">
                                                                    Observaciones
                                                                </label>

                                                                <textarea name="Observaciones"
                                                                          class="form-control rounded-3"
                                                                          rows="3"
                                                                          placeholder="Ingrese las observaciones de la inspección"></textarea>

                                                            </div>


                                                            <div class="mt-3 text-end">

                                                                <button type="submit"
                                                                        class="btn btn-monher-primary">

                                                                    <i class="fa-solid fa-clipboard-check me-2"></i>
                                                                    Registrar control de calidad

                                                                </button>

                                                            </div>

                                                        </form>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                    }


                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>



<!-- ====================================================== -->
<!-- HU006: MODAL CREAR ORDEN DE PRODUCCIÓN                 -->
<!-- ====================================================== -->

<div class="modal fade"
     id="newOrderModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content card-monher p-3">

            <form asp-action="Create"
                  method="post">


                <div class="modal-header border-0 pb-0">

                    <h5 class="modal-title fw-bold">
                        Crear Orden de Producción (HU006)
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">


                    <!-- CLIENTE -->
                    <div class="mb-3">

                        <label class="form-label text-muted small fw-bold">
                            Cliente
                        </label>

                        <input type="text"
                               class="form-control rounded-3"
                               name="Cliente"
                               required
                               placeholder="Nombre del cliente" />

                    </div>


                    <!-- PRODUCTO -->
                    <div class="mb-3">

                        <label class="form-label text-muted small fw-bold">
                            Producto a fabricar
                        </label>

                        <select class="form-select rounded-3"
                                name="TipoCaja"
                                required>

                            @foreach (var p in
                                (List<DIS_Monher.Models.ProductoTerminado>)ViewBag.Productos)
                            {
                                <option value="@p.Nombre">
                                    @p.Nombre
                                </option>
                            }

                        </select>

                        <small class="text-muted">
                            Los materiales se descuentan automáticamente según la composición del producto.
                        </small>

                    </div>


                    <div class="row">


                        <!-- CANTIDAD -->
                        <div class="col-md-6 mb-3">

                            <label class="form-label text-muted small fw-bold">
                                Cantidad
                            </label>

                            <input type="number"
                                   class="form-control rounded-3"
                                   name="Cantidad"
                                   required
                                   placeholder="100" />

                        </div>


                        <!-- FECHA -->
                        <div class="col-md-6 mb-3">

                            <label class="form-label text-muted small fw-bold">
                                Fecha Entrega
                            </label>

                            <input type="date"
                                   class="form-control rounded-3"
                                   name="FechaEntrega"
                                   required />

                        </div>

                    </div>


                    <!-- RESPONSABLE -->
                    <div class="mb-3">

                        <label class="form-label text-muted small fw-bold">
                            Responsable
                        </label>

                        <input type="text"
                               class="form-control rounded-3"
                               name="Responsable"
                               required
                               placeholder="Nombre de encargado" />

                    </div>

                </div>


                <div class="modal-footer border-0 pt-0">

                    <button type="button"
                            class="btn btn-light text-muted px-3"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-monher-primary px-4">

                        Generar Orden

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>