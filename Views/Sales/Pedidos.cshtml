@model IEnumerable<DIS_Monher.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos y Ventas";

    var clientes =
        (List<DIS_Monher.Models.Cliente>)ViewBag.Clientes;

    var productos =
        (List<DIS_Monher.Models.ProductoTerminado>)ViewBag.Productos;
}

<style>

    .producto {
    padding-right: 3rem;
    font-size: 0.95rem;
    }

    .pedido-stepper {
        background: #fff;
        border-radius: 16px;
        padding: 22px 30px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, .05);
    }

    .pedido-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        max-width: 760px;
        margin: auto;
    }

    .pedido-steps::before {
        content: "";
        position: absolute;
        top: 18px;
        left: 8%;
        right: 8%;
        height: 3px;
        background: #e4e9f2;
        z-index: 0;
    }

    .pedido-step {
        text-align: center;
        position: relative;
        z-index: 1;
        min-width: 100px;
    }

    .pedido-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        background: #edf1f7;
        color: #8793a5;
        border: 3px solid white;
    }

    .pedido-step.active .pedido-circle {
        background: #377dff;
        color: white;
    }

    .pedido-label {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
    }

    .pedido-step.active .pedido-label {
        color: #2563eb;
    }


    /* ======================================================
       TARJETAS
       ====================================================== */

    .pedido-card {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, .05);
        height: 100%;
    }

    .pedido-card-title {
        font-weight: 700;
        color: #172033;
        margin-bottom: 20px;
    }

    .pedido-section-title {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 10px;
    }


    /* ======================================================
       PRODUCTOS DEL PEDIDO
       ====================================================== */

    .linea-producto {
        background: #f8fafc;
        border: 1px solid #e7ecf3;
        border-radius: 12px;
        padding: 12px;
    }

    .subtotal {
        white-space: nowrap;
        color: #172033;
    }

    .pedido-total {
        background: #eef5ff;
        border-radius: 12px;
        padding: 17px 20px;
    }


    /* ======================================================
       ESTADOS
       ====================================================== */

    .estado-pedido {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .estado-registrado {
        background: #dbeafe;
        color: #2563eb;
    }

    .estado-confirmado {
        background: #fef3c7;
        color: #b45309;
    }

    .estado-despachado {
        background: #ede9fe;
        color: #7c3aed;
    }

    .estado-vendido {
        background: #dcfce7;
        color: #15803d;
    }

</style>


<!-- ======================================================
     ENCABEZADO
     ====================================================== -->

<div class="mb-4">

    <h2 class="fw-bold text-dark mb-1">
        Gestión de Pedidos y Ventas
    </h2>

    <p class="text-muted mb-0">
        Registra clientes y genera pedidos para validar su disponibilidad.
    </p>

</div>


<!-- ======================================================
     MENSAJES
     ====================================================== -->

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success border-0 rounded-3 mb-4">

        <i class="fa-solid fa-circle-check me-2"></i>

        @TempData["Ok"]

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-3 mb-4">

        <i class="fa-solid fa-circle-exclamation me-2"></i>

        @TempData["Error"]

    </div>
}


<!-- ======================================================
     FLUJO DEL PEDIDO
     ====================================================== -->

<div class="pedido-stepper mb-4">

    <div class="pedido-steps">


        <!-- PASO 1 -->
        <div class="pedido-step active">

            <div class="pedido-circle">
                1
            </div>

            <span class="pedido-label">
                Datos
            </span>

        </div>


        <!-- PASO 2 -->
        <div class="pedido-step active">

            <div class="pedido-circle">
                2
            </div>

            <span class="pedido-label">
                Productos
            </span>

        </div>


        <!-- PASO 3 -->
        <div class="pedido-step">

            <div class="pedido-circle">
                3
            </div>

            <span class="pedido-label">
                Stock
            </span>

        </div>


        <!-- PASO 4 -->
        <div class="pedido-step">

            <div class="pedido-circle">
                4
            </div>

            <span class="pedido-label">
                Confirmar
            </span>

        </div>

    </div>

</div>



<!-- ======================================================
     CLIENTE + CREAR PEDIDO
     ====================================================== -->

<div class="row g-4 mb-4">


    <!-- ==================================================
         REGISTRAR CLIENTE
         ================================================== -->

    <div class="col-lg-4">

        <div class="pedido-card">

            <h5 class="pedido-card-title">

                <i class="fa-solid fa-user-plus text-primary me-2"></i>

                Registrar Cliente

            </h5>


            <form asp-action="CrearCliente"
                  method="post">


                <!-- DOCUMENTO -->
                <div class="mb-3">

                    <label class="form-label text-muted small fw-bold">
                        Documento (RUC / DNI)
                    </label>

                    <input type="text"
                           class="form-control rounded-3"
                           name="Documento"
                           required
                           placeholder="Ej. 41882736" />

                </div>


                <!-- NOMBRE -->
                <div class="mb-3">

                    <label class="form-label text-muted small fw-bold">
                        Razón Social / Nombre
                    </label>

                    <input type="text"
                           class="form-control rounded-3"
                           name="RazonSocial"
                           required
                           placeholder="Ej. Gloria Paredes" />

                </div>


                <!-- CONTACTO -->
                <div class="mb-3">

                    <label class="form-label text-muted small fw-bold">
                        Contacto / Teléfono
                    </label>

                    <input type="text"
                           class="form-control rounded-3"
                           name="Contacto"
                           placeholder="Ej. +51 987654321" />

                </div>


                <!-- DIRECCIÓN -->
                <div class="mb-4">

                    <label class="form-label text-muted small fw-bold">
                        Dirección
                    </label>

                    <input type="text"
                           class="form-control rounded-3"
                           name="Direccion"
                           placeholder="Ej. Av. Javier Prado 123" />

                </div>


                <!-- BOTÓN -->
                <button type="submit"
                        class="btn btn-monher-primary w-100">

                    <i class="fa-solid fa-floppy-disk me-2"></i>

                    Guardar Cliente

                </button>


            </form>

        </div>

    </div>



    <!-- ==================================================
         CREAR PEDIDO
         ================================================== -->

    <div class="col-lg-8">

        <div class="pedido-card">

            <div class="d-flex justify-content-between align-items-start mb-4">

                <div>

                    <h5 class="pedido-card-title mb-1">

                        <i class="fa-solid fa-cart-plus text-primary me-2"></i>

                        Crear Pedido

                    </h5>

                    <p class="text-muted small mb-0">
                        Selecciona el cliente, los productos solicitados y la fecha de entrega.
                    </p>

                </div>

            </div>


            <form asp-action="CrearPedido"
                  method="post">


                <!-- ======================================
                     DATOS GENERALES
                     ====================================== -->

                <div class="pedido-section-title">
                    Datos del pedido
                </div>


                <div class="row g-3 mb-4">


                    <!-- CLIENTE -->
                    <div class="col-md-7">

                        <label class="form-label text-muted small fw-bold">
                            Cliente
                        </label>

                        <select name="clienteId"
                                class="form-select rounded-3"
                                required>

                            @if (clientes.Any())
                            {
                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.Id">

                                        @cliente.RazonSocial
                                        (@cliente.Documento)

                                    </option>
                                }
                            }
                            else
                            {
                                <option value="">
                                    Primero registre un cliente
                                </option>
                            }

                        </select>

                    </div>


                    <!-- FECHA -->
                    <div class="col-md-5">

                        <label class="form-label text-muted small fw-bold">
                            Fecha de Entrega
                        </label>

                        <input type="date"
                            class="form-control rounded-3"
                            name="fechaEntrega"
                            lang="es-PE"
                            min="@DateTime.Today.ToString("yyyy-MM-dd")"
                            required />

                    </div>

                </div>



                <!-- ======================================
                     PRODUCTOS
                     ====================================== -->

                <div class="pedido-section-title">
                    Productos solicitados
                </div>


                <div id="lineas">

                    <div class="linea linea-producto mb-3">

                        <div class="row g-2 align-items-center">


                            <!-- PRODUCTO -->
                            <div class="col-md-7">

                                <label class="form-label small text-muted mb-1">
                                    Producto
                                </label>

                                <select name="productoIds"
                                        class="form-select rounded-3 producto"
                                        required>

                                    @foreach (var producto in productos)
                                    {
                                        <option value="@producto.Id"
                                                data-precio="@producto.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                            @producto.Nombre
                                            — S/ @producto.PrecioUnitario.ToString("N2")

                                        </option>
                                    }

                                </select>

                            </div>


                            <!-- CANTIDAD -->
                            <div class="col-md-2">

                                <label class="form-label small text-muted mb-1">
                                    Cantidad
                                </label>

                                <input type="number"
                                       min="1"
                                       name="cantidades"
                                       value="1"
                                       class="form-control rounded-3 cantidad"
                                       required />

                            </div>


                            <!-- SUBTOTAL -->
                            <div class="col-md-2 text-end">

                                <label class="form-label small text-muted mb-1 d-block">
                                    Subtotal
                                </label>

                                <span class="fw-bold subtotal">
                                    S/ 0.00
                                </span>

                            </div>


                            <!-- ELIMINAR -->
                            <div class="col-md-1 text-end">

                                <label class="form-label small text-muted mb-1 d-block">
                                    &nbsp;
                                </label>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger quitar"
                                        title="Eliminar producto">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </div>


                        </div>

                    </div>

                </div>



                <!-- AGREGAR -->
                <button type="button"
                        id="agregarLinea"
                        class="btn btn-sm btn-outline-primary mb-4">

                    <i class="fa-solid fa-plus me-1"></i>

                    Agregar producto

                </button>



                <!-- ======================================
                     RESUMEN
                     ====================================== -->

                <div class="pedido-total">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted d-block">
                                Total estimado del pedido
                            </small>

                            <h3 class="fw-bold text-primary mb-0">

                                <span id="totalPedido">
                                    S/ 0.00
                                </span>

                            </h3>

                        </div>


                        <button type="submit"
                                class="btn btn-monher-primary px-4 py-2"
                                @(clientes.Any() && productos.Any()
                                    ? ""
                                    : "disabled")>

                            Generar y validar pedido

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </button>

                    </div>

                </div>


            </form>

        </div>

    </div>

</div>



<!-- ======================================================
     PEDIDOS REGISTRADOS
     ====================================================== -->

<div class="pedido-card">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h5 class="fw-bold text-dark mb-1">
                Pedidos Registrados
            </h5>

            <p class="text-muted small mb-0">
                Consulta el estado actual y continúa con el siguiente paso del proceso.
            </p>

        </div>

        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">

            @Model.Count() pedido(s)

        </span>

    </div>



    <div class="table-responsive">

        <table class="table table-monher align-middle">

            <thead>

                <tr>

                    <th>Código</th>

                    <th>Cliente</th>

                    <th>Fecha de entrega</th>

                    <th>Total</th>

                    <th>Estado</th>

                    <th class="text-end">
                        Acción
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var pedido in Model)
                {
                    <tr>


                        <!-- CÓDIGO -->
                        <td>

                            <span class="fw-bold text-primary">
                                @pedido.CodigoPedido
                            </span>

                        </td>


                        <!-- CLIENTE -->
                        <td>

                            <div class="fw-semibold">
                                @pedido.Cliente?.RazonSocial
                            </div>

                            <small class="text-muted">
                                @pedido.Cliente?.Documento
                            </small>

                        </td>


                        <!-- FECHA -->
                        <td>

                            @pedido.FechaEntrega.ToString("dd/MM/yyyy")

                        </td>


                        <!-- TOTAL -->
                        <td class="fw-bold">

                            S/ @pedido.Total.ToString("N2")

                        </td>


                        <!-- ESTADO -->
                        <td>

                            @switch (pedido.Estado)
                            {
                                case "Registrado":

                                    <span class="estado-pedido estado-registrado">

                                        <i class="fa-solid fa-clock"></i>

                                        Registrado

                                    </span>

                                    break;


                                case "Confirmado":

                                    <span class="estado-pedido estado-confirmado">

                                        <i class="fa-solid fa-box"></i>

                                        Confirmado

                                    </span>

                                    break;


                                case "Despachado":

                                    <span class="estado-pedido estado-despachado">

                                        <i class="fa-solid fa-truck"></i>

                                        Despachado

                                    </span>

                                    break;


                                case "Vendido":

                                    <span class="estado-pedido estado-vendido">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Vendido

                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary">

                                        @pedido.Estado

                                    </span>

                                    break;
                            }

                        </td>


                        <!-- ACCIÓN -->
                        <td class="text-end">

                            @switch (pedido.Estado)
                            {

                                case "Registrado":

                                    <a asp-action="VerificarDisponibilidad"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="fa-solid fa-box-open me-1"></i>

                                        Validar stock

                                    </a>

                                    break;


                                case "Confirmado":

                                    <a asp-action="DespachoView"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="fa-solid fa-truck-fast me-1"></i>

                                        Gestionar despacho

                                    </a>

                                    break;


                                case "Despachado":

                                    <a asp-action="Facturacion"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="fa-solid fa-file-invoice me-1"></i>

                                        Facturar

                                    </a>

                                    break;


                                default:

                                    <span class="text-success fw-semibold small">

                                        <i class="fa-solid fa-circle-check me-1"></i>

                                        Completado

                                    </span>

                                    break;
                            }

                        </td>


                    </tr>
                }


                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-5">

                            <i class="fa-solid fa-cart-shopping fs-3 mb-3 d-block"></i>

                            Todavía no existen pedidos registrados.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>



@section Scripts {

<script>

    const lineas =
        document.getElementById('lineas');

    const agregarLinea =
        document.getElementById('agregarLinea');

    const totalPedido =
        document.getElementById('totalPedido');


    // Guardamos una copia de la primera fila
    const plantilla =
        lineas.firstElementChild.cloneNode(true);



    // =====================================================
    // RECALCULAR TOTAL
    // =====================================================

    function recalcular() {

        let total = 0;


        lineas
            .querySelectorAll('.linea')
            .forEach(linea => {


                const producto =
                    linea.querySelector('.producto');


                const opcion =
                    producto.options[producto.selectedIndex];


                const precio =
                    parseFloat(
                        opcion?.dataset.precio || 0
                    );


                const cantidad =
                    parseInt(
                        linea.querySelector('.cantidad').value
                    ) || 0;


                const subtotal =
                    precio * cantidad;


                linea
                    .querySelector('.subtotal')
                    .textContent =
                        'S/ ' + subtotal.toFixed(2);


                total += subtotal;

            });


        totalPedido.textContent =
            'S/ ' + total.toFixed(2);

    }



    // =====================================================
    // AGREGAR PRODUCTO
    // =====================================================

    agregarLinea.addEventListener(
        'click',
        function () {

            const nueva =
                plantilla.cloneNode(true);


            nueva
                .querySelector('.cantidad')
                .value = 1;


            lineas.appendChild(nueva);


            recalcular();

        }
    );



    // =====================================================
    // CAMBIOS
    // =====================================================

    lineas.addEventListener(
        'input',
        recalcular
    );


    lineas.addEventListener(
        'change',
        recalcular
    );



    // =====================================================
    // ELIMINAR PRODUCTO
    // =====================================================

    lineas.addEventListener(
        'click',
        function (e) {

            const boton =
                e.target.closest('.quitar');


            if (!boton)
                return;


            if (
                lineas.querySelectorAll('.linea').length <= 1
            ) {
                return;
            }


            boton
                .closest('.linea')
                .remove();


            recalcular();

        }
    );



    // CALCULAR AL CARGAR
    recalcular();

</script>

}