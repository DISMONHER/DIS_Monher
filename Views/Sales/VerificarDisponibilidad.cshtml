@model DIS_Monher.Models.Pedido

@{
    ViewData["Title"] = "Verificar Disponibilidad";

    var reservados = (Dictionary<int, int>)ViewBag.Reservados;

    Func<DIS_Monher.Models.DetallePedido, decimal> disponible = d =>
        d.ProductoTerminado!.StockActual -
        reservados.GetValueOrDefault(d.ProductoTerminadoId);

    bool todoDisponible =
        Model.Detalles.All(d => disponible(d) >= d.Cantidad);

    bool pedidoConfirmado =
        Model.Estado != "Registrado";
}

<style>
    .hu12-stepper {
        background: #fff;
        border-radius: 16px;
        padding: 24px 30px;
        box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

    .hu12-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        max-width: 760px;
        margin: auto;
    }

    .hu12-steps::before {
        content: "";
        position: absolute;
        top: 18px;
        left: 8%;
        right: 8%;
        height: 3px;
        background: #e4e9f2;
        z-index: 0;
    }

    .hu12-step {
        text-align: center;
        position: relative;
        z-index: 1;
        min-width: 100px;
    }

    .hu12-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        background: #edf1f7;
        color: #8793a5;
        border: 3px solid white;
    }

    .hu12-step.completed .hu12-circle {
        background: #377dff;
        color: white;
    }

    .hu12-step.active .hu12-circle {
        background: #ff7a00;
        color: white;
    }

    .hu12-label {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
    }

    .hu12-stock-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

    .stock-disponible {
        background: #dcfce7;
        color: #15803d;
    }

    .stock-bajo {
        background: #fef3c7;
        color: #b45309;
    }

    .stock-agotado {
        background: #fee2e2;
        color: #dc2626;
    }

    .estado-stock {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .hu12-info {
        background: #eef6ff;
        border: 1px solid #d7e8ff;
        color: #3267b2;
        border-radius: 12px;
        padding: 15px 18px;
    }
</style>


<!-- ENCABEZADO -->
<div class="mb-4">

    <div class="d-flex justify-content-between align-items-start">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                Verificación de Disponibilidad
            </h2>

            <p class="text-muted mb-0">
                Confirma el stock antes de continuar con el pedido
                <strong class="text-primary">
                    @Model.CodigoPedido
                </strong>.
            </p>
        </div>

        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
            Estado: @Model.Estado
        </span>

    </div>

</div>


<!-- PASOS -->
<div class="hu12-stepper mb-4">

    <div class="hu12-steps">

        <div class="hu12-step completed">

            <div class="hu12-circle">
                <i class="fa-solid fa-check"></i>
            </div>

            <span class="hu12-label">
                Datos
            </span>

        </div>


        <div class="hu12-step completed">

            <div class="hu12-circle">
                <i class="fa-solid fa-check"></i>
            </div>

            <span class="hu12-label">
                Productos
            </span>

        </div>


        <div class="hu12-step @(pedidoConfirmado ? "completed" : "active")">

            <div class="hu12-circle">
                @if (pedidoConfirmado)
                {
                    <i class="fa-solid fa-check"></i>
                }
                else
                {
                    <span>3</span>
                }
            </div>

            <span class="hu12-label">
                Stock
            </span>

        </div>


        <div class="hu12-step @(pedidoConfirmado ? "active" : "")">

            <div class="hu12-circle">
                <span>4</span>
            </div>

            <span class="hu12-label">
                Confirmar
            </span>

        </div>

    </div>

</div>


<!-- VALIDACIÓN DE ALMACÉN -->
<div class="hu12-stock-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h5 class="fw-bold text-dark mb-1">
                Validación de Almacén
            </h5>

            <small class="text-muted">
                Stock disponible considerando reservas de otros pedidos.
            </small>
        </div>

        <span class="badge bg-light text-primary border px-3 py-2">
            <i class="fa-solid fa-clock me-1"></i>
            Actualizado ahora
        </span>

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead class="table-light">

                <tr>
                    <th>Producto</th>
                    <th>Cant. solicitada</th>
                    <th>Stock físico</th>
                    <th>Reservado</th>
                    <th>Disponible</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    var stockDisponible = disponible(detalle);

                    var faltante =
                        detalle.Cantidad - stockDisponible;

                    <tr>

                        <!-- PRODUCTO -->
                        <td>

                            <div class="fw-bold text-dark">
                                @detalle.ProductoTerminado?.Nombre
                            </div>

                            <small class="text-muted">
                                @detalle.ProductoTerminado?.Codigo
                            </small>

                        </td>


                        <!-- SOLICITADO -->
                        <td class="fw-semibold">
                            @detalle.Cantidad
                        </td>


                        <!-- STOCK FÍSICO -->
                        <td>
                            @detalle.ProductoTerminado?.StockActual.ToString("N2")
                        </td>


                        <!-- RESERVADO -->
                        <td>
                            @reservados.GetValueOrDefault(
                                detalle.ProductoTerminadoId)
                        </td>


                        <!-- DISPONIBLE -->
                        <td class="fw-bold">

                            @stockDisponible.ToString("N2")

                        </td>


                        <!-- ESTADO -->
                        <td>

                            @if (stockDisponible >= detalle.Cantidad)
                            {
                                <span class="estado-stock stock-disponible">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Disponible

                                </span>
                            }
                            else if (stockDisponible > 0)
                            {
                                <span class="estado-stock stock-bajo">

                                    <i class="fa-solid fa-triangle-exclamation"></i>

                                    Stock bajo

                                </span>

                                <div class="small text-danger mt-1">

                                    Faltan
                                    <strong>
                                        @faltante.ToString("N2")
                                    </strong>
                                    unidad(es)

                                </div>
                            }
                            else
                            {
                                <span class="estado-stock stock-agotado">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    Agotado

                                </span>

                                <div class="small text-danger mt-1">

                                    Requiere
                                    <strong>
                                        @detalle.Cantidad
                                    </strong>
                                    unidad(es)

                                </div>
                            }

                        </td>


                        <!-- ACCIÓN -->
                        <td>

                            @if (stockDisponible >= detalle.Cantidad)
                            {
                                <span class="text-success fw-semibold small">

                                    <i class="fa-solid fa-check me-1"></i>

                                    Listo para reservar

                                </span>
                            }
                            else
                            {
                                <a asp-controller="Production"
                                   asp-action="Index"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="fa-solid fa-gears me-1"></i>

                                    Solicitar producción

                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <hr />


    <!-- BOTONES -->
    <div class="d-flex justify-content-end align-items-center gap-2 mt-4">

        <a asp-action="Pedidos"
           class="btn btn-light border px-4">

            Regresar

        </a>


        @if (Model.Estado != "Registrado")
        {
            <a asp-action="DespachoView"
               asp-route-id="@Model.Id"
               class="btn btn-monher-primary px-4">

                <i class="fa-solid fa-truck me-2"></i>

                Continuar con despacho

            </a>
        }
        else if (todoDisponible)
        {
            <form asp-action="ConfirmarReserva"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-monher-primary px-4">

                    <i class="fa-solid fa-lock me-2"></i>

                    Confirmar y reservar stock

                </button>

            </form>
        }
        else
        {
            <a asp-controller="Production"
               asp-action="Index"
               class="btn btn-monher-primary px-4">

                <i class="fa-solid fa-gears me-2"></i>

                Crear orden de producción

            </a>
        }

    </div>

</div>


<!-- INFORMACIÓN DE RESERVA -->
<div class="hu12-info">

    <div class="d-flex align-items-start gap-3">

        <i class="fa-solid fa-circle-info mt-1"></i>

        <div>

            <div class="fw-bold">
                Reserva de stock
            </div>

            <small>
                El stock se reservará cuando se confirme el pedido.
                Las cantidades reservadas por otros pedidos se descuentan
                automáticamente de la disponibilidad mostrada.
            </small>

        </div>

    </div>

</div>